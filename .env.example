# Supabase Configuration
# Provide your Supabase project URL and public Anon Key to connect live PostgreSQL.
# If left blank, the application transparently runs in High-Performance Local Database Mode
# with complete offline durability and full preloaded MSN 12345/12346/12347 dataset.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email Configuration (Resend)
# If provided, transactional emails are sent via Resend API.
# If left blank, the application automatically uses Interactive In-App Outbox Mode
# allowing complete workflow email testing and review directly within the app!
RESEND_API_KEY=
EMAIL_FROM=ops@alarisaerospace.com

